// Wrangler 설정 파일 (JSON + 주석 허용)
// 사내 문서 AI 챗봇: 정적 화면(public/) + API(Hono) + 큐 소비자 + 채팅 에이전트(Durable Object)를 Worker 하나로 배포합니다.
//
// 두 가지 실행 방법이 있습니다.
//   npm run dev       진짜 AI 모드. Workers AI·Vectorize 는 로컬 흉내가 없어서 Cloudflare 계정의 실제 리소스를 씁니다(로그인 필요, 무료 한도 차감).
//   npm run dev:mock  연습 모드(아래 env.mock). 로그인 없이 가짜 임베딩·가짜 답변으로 화면과 흐름만 확인합니다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "doc-chatbot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Agents SDK 가 Node.js 호환 API(AsyncLocalStorage 등)를 씁니다.
  "compatibility_flags": ["nodejs_compat"],

  // Workers Logs: 대시보드에서 console.log 를 볼 수 있게 합니다.
  "observability": { "enabled": true },

  // ── Workers Static Assets ─────────────────────────────────
  // public/ 의 채팅 화면(index.html)과 문서 관리 화면(admin.html)을 그대로 서비스합니다.
  // /api/* (문서 API)와 /agents/* (채팅 WebSocket)만 Worker 코드가 먼저 받습니다.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/agents/*"]
  },

  // ── R2: 올린 원본 문서 ─────────────────────────────────────
  // 배포 전에 `npx wrangler r2 bucket create doc-chatbot-files` (R2 는 id 없이 이름으로 연결)
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "doc-chatbot-files" }],

  // ── D1: 문서 목록과 청크 원문 ──────────────────────────────
  // `npx wrangler d1 create doc-chatbot-db` 를 실행하고, 출력된 database_id 를 아래에 직접 붙여 넣으세요.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "doc-chatbot-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // ── Queues: 업로드 후 색인 작업을 뒤에서 처리 ─────────────
  // `npx wrangler queues create doc-chatbot-index-jobs`
  // 같은 Worker 가 생산자(업로드 API)이자 소비자(queue 핸들러)입니다.
  "queues": {
    "producers": [{ "binding": "INDEX_QUEUE", "queue": "doc-chatbot-index-jobs" }],
    "consumers": [
      {
        "queue": "doc-chatbot-index-jobs",
        "max_batch_size": 1, // 문서 하나가 무거운 작업이라 한 번에 하나씩
        "max_batch_timeout": 1, // 메시지가 오면 1초 안에 처리 시작
        "max_retries": 2 // 실패하면 2번 더(총 3번) 시도 후 '실패'로 표시
      }
    ]
  },

  // ── Workers AI ────────────────────────────────────────────
  // 문서 변환(toMarkdown), 임베딩, 답변 생성. 모델은 로컬에서도 항상 Cloudflare 에서 실행됩니다(remote: true).
  "ai": { "binding": "AI", "remote": true },

  // ── Vectorize: 청크 벡터 저장·검색 ─────────────────────────
  // 로컬 흉내가 없어서 dev 에서도 실제 인덱스를 씁니다(remote: true). 만들기:
  //   npx wrangler vectorize create doc-chatbot-index --dimensions=1024 --metric=cosine
  //   npx wrangler vectorize create-metadata-index doc-chatbot-index --propertyName=docId --type=string
  "vectorize": [{ "binding": "VECTORS", "index_name": "doc-chatbot-index", "remote": true }],

  // ── Durable Object: 채팅 에이전트 (Agents SDK) ─────────────
  // 브라우저마다 ChatAgent 인스턴스 하나가 생기고, 대화 기록을 자기 SQLite 에 저장합니다.
  // 무료 플랜은 SQLite 저장소만 지원하므로 new_sqlite_classes 로 선언합니다.
  "durable_objects": { "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],

  // ── Rate Limiting: 채팅 남용 방지 ──────────────────────────
  // IP 하나당 60초에 10번까지 질문. namespace_id 는 계정 안에서 고르는 아무 정수(문자열).
  // 위치(데이터센터)별 근사치 제한이라 정확한 전역 제한은 아닙니다.
  "ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } }],

  // 비밀이 아닌 설정값. 비밀 값(ADMIN_TOKEN)은 .dev.vars / `wrangler secret put`.
  "vars": {
    "MOCK_AI": "0",
    // Vectorize 네임스페이스. 로컬 dev 와 배포본이 같은 원격 인덱스를 쓰므로, 벡터 id 앞에 붙이고 검색 범위도 나눕니다.
    // 배포본은 "prod", 로컬은 .dev.vars 의 VECTOR_NAMESPACE=dev 가 이 값을 덮어씁니다.
    "VECTOR_NAMESPACE": "prod",
    // AI Gateway 이름. 대시보드 AI > AI Gateway 에서 같은 이름으로 만드세요. 비워 두면 게이트웨이 없이 호출합니다.
    "AI_GATEWAY_ID": "doc-chatbot",
    // 답변 모델과 임베딩 모델. 임베딩 모델을 바꾸면 Vectorize 인덱스 차원(1024)도 맞춰 다시 만들어야 합니다.
    // gemma-4-26b-a4b-it 는 Cloudflare 가 무료 플랜에서 쓸 수 있다고 밝힌 모델입니다(gemma-3-12b-it 는 2026-05-30 지원 종료).
    // 다른 모델을 시험할 때는 이 값을 고치거나, 로컬에서는 .dev.vars 에 CHAT_MODEL=... 을 넣어 덮어쓰세요.
    "CHAT_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "EMBED_MODEL": "@cf/baai/bge-m3",
    // 이미지(JPG·PNG·WebP) 글자 읽기(OCR)용 비전 모델. gemma-4 는 비전·OCR 을 지원합니다.
    "OCR_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "MAX_UPLOAD_MB": "10",
    "MAX_IMAGE_MB": "4",
    // 문서 하나의 최대 청크 수. Vectorize 무료 저장 한도(500만 차원 ≈ 1024차원 4,880개)를 지키기 위한 안전장치.
    "MAX_CHUNKS_PER_DOC": "400"
  },

  // ── 연습 모드: npm run dev:mock ────────────────────────────
  // 바인딩은 환경마다 따로 선언해야 해서 AI·Vectorize 만 빼고 위와 같이 반복합니다.
  "env": {
    "mock": {
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "doc-chatbot-files" }],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "doc-chatbot-db",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "INDEX_QUEUE", "queue": "doc-chatbot-index-jobs" }],
        "consumers": [{ "queue": "doc-chatbot-index-jobs", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 2 }]
      },
      "durable_objects": { "bindings": [{ "name": "ChatAgent", "class_name": "ChatAgent" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatAgent"] }],
      "ratelimits": [{ "name": "CHAT_LIMITER", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } }],
      "vars": {
        "MOCK_AI": "1",
        "VECTOR_NAMESPACE": "mock",
        "AI_GATEWAY_ID": "",
        "CHAT_MODEL": "mock",
        "EMBED_MODEL": "mock",
        "OCR_MODEL": "mock",
        "MAX_UPLOAD_MB": "10",
        "MAX_IMAGE_MB": "4",
        "MAX_CHUNKS_PER_DOC": "400"
      }
    }
  }
}
