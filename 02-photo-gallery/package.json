{
  "name": "photo-gallery",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Workers 정적 자산 + R2 + D1 + Images 로 만드는 사진 갤러리 (학습용 미니 프로젝트 2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply photo-gallery-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply photo-gallery-db --remote",
    "postinstall": "wrangler types",
    "types": "wrangler types",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.22"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "wrangler": "^4.168.0"
  }
}
